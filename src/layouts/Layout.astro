---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Gopal Bhunia - Software Developer building interactive and seamless digital experiences with cutting-edge frontend development."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://darkminimal.vercel.app/" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Gopal Bhunia | Software Developer"
    />
    <meta
      property="og:description"
      content="Portfolio of Gopal Bhunia, Software Developer specializing in frontend and interactive experiences."
    />
    <meta
      property="og:image"
      content="https://darkminimal.vercel.app/og.image.png"
    />
    <meta property="og:url" content="https://darkminimal.vercel.app" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Gopal Bhunia Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Gopal Bhunia",
        "alternateName": "Gopal Bhunia",
        "url": "https://darkminimal.vercel.app",
        "image": "https://darkminimal.vercel.app/og.image.png",
        "sameAs": [
          "https://github.com",
          "https://linkedin.com"
        ],
        "jobTitle": "Software Developer",
        "description": "Software Developer building interactive and seamless digital experiences."
      }
    </script>
  </head>
  <body class="bg-[var(--background)] sm:px-28 lg:px-20 px-9">
    <slot />
  </body>
</html>
